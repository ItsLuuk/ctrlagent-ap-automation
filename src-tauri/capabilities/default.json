{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions for Foundry (Tauri 2)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-appcache-read",
    "fs:allow-appcache-write",
    "fs:allow-appconfig-read",
    "fs:allow-appconfig-write",
    "fs:allow-appdata-read",
    "fs:allow-appdata-write",
    "fs:allow-applocaldata-read",
    "fs:allow-applocaldata-write",
    "fs:allow-applog-read",
    "fs:allow-applog-write",
    "os:default",
    "os:allow-platform",
    "os:allow-arch",
    "os:allow-os-type",
    "os:allow-version",
    "shell:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "vision-runtime",
          "cmd": "$RESOURCE/runtime/ollama.exe",
          "args": ["serve"]
        }
      ]
    }
  ]
}
