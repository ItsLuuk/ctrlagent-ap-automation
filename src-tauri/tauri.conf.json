{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Foundry",
  "version": "0.1.0",
  "identifier": "com.foundry.apautomation",
  "build": {
    "frontendDist": "../dist-tauri",
    "devUrl": "http://127.0.0.1:5173/tauri.html",
    "beforeDevCommand": "bun run dev:vite",
    "beforeBuildCommand": "bun run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "Foundry",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "windows/payload-installer.ps1": "payload-installer.ps1"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
